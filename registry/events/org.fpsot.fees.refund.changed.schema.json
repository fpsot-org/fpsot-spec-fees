{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpsot.org/schemas/fees/events/org.fpsot.fees.refund.changed.schema.json",
  "$comment": "SPDX-License-Identifier: Community-Spec-1.0. FPSOT fees event data (FEE-075). The data holds identifiers, codes and instants only, never a party id, a payment reference, an amount or card data (FEE-076). A consumer reads the record by its id. The CloudEvents attributes follow API-101.",
  "title": "org.fpsot.fees.refund.changed",
  "description": "A refund took a new status (FEE-060, FEE-075).",
  "type": "object",
  "required": [
    "refundId",
    "orderId",
    "attemptId",
    "status",
    "reason",
    "changedAt"
  ],
  "properties": {
    "refundId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The refund (FEE-060)."
    },
    "orderId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The order (FEE-040)."
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The attempt (FEE-060)."
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "success",
        "error"
      ],
      "description": "The new status (FEE-060)."
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The refund reason of the profile (FEE-062)."
    },
    "remissionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The remission that the refund carries out, if any (FEE-065)."
    },
    "changedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "When the engine set the status (FEE-060)."
    }
  },
  "additionalProperties": false
}
